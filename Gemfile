source "https://rubygems.org"

# One Gemfile for the whole collection: build.rb runs every text and the
# portal with it. Jekyll 3.10 is the version GitHub Pages itself used to
# build the five original sites, so pages render exactly as before.
gem "jekyll", "~> 3.10"
gem "kramdown-parser-gfm", "~> 1.1"
gem "webrick", "~> 1.8"   # for `jekyll serve` on Ruby 3
