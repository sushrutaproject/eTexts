permalink: /search-index/nidanas.json
layout: null
sitemap: false
---
{%- comment -%}
Strip inline footnote references before indexing: their digits would
otherwise land in the middle of the text and break phrase searches.
Liquid has no regex, so we split on the <sup> markup and keep only what
follows each closing tag. The notes themselves stay indexed.
{%- endcomment -%}
[{% for c in site.nidanas %}{%- assign parts = c.content | split: '<sup' -%}
{%- capture body -%}{{ parts[0] }}{% for p in parts offset:1 %}{{ p | split: '</sup>' | last }}{% endfor %}{%- endcapture -%}
{"title": {{ c.title | jsonify }},"adhyaya": {{ c.adhyaya }},"url": {{ c.url | relative_url | jsonify }},"text": {{ body | strip_html | normalize_whitespace | jsonify }}}{% unless forloop.last %},{% endunless %}{% endfor %}]
